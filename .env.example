# Скопируй этот файл в .env и заполни своими значениями:
#   cp .env.example .env

# ── OpenRouter API ────────────────────────────────────────────────────────────
# Получить на: https://openrouter.ai → Keys
OPENROUTER_API_KEY=sk-or-v1-ваш_ключ_здесь

# ── Groq Whisper API (через Cloudflare Worker-прокси) ─────────────────────────
# Ключ: https://console.groq.com/keys (Free tier, карту не спрашивают)
# Прокси нужен т.к. Groq блокирует российские IP (Cloudflare geo-block).
GROQ_API_KEY=gsk_ваш_ключ_здесь
GROQ_PROXY_URL=https://groq-proxy.ТВОЙНИК.workers.dev
GROQ_PROXY_SECRET=секрет_который_в_коде_воркера

# ── Telegram-бот ──────────────────────────────────────────────────────────────
# 1. Напиши @BotFather в Telegram → /newbot → получи токен
TELEGRAM_BOT_TOKEN=1234567890:AAHdqTcvCH1vGWJxfSeofSAs0K5PALDsaw

# 2. Узнай свой Telegram ID: напиши @userinfobot → скопируй "Id:"
TELEGRAM_CHAT_ID=123456789
